# ---------- Database ----------
# PostgreSQL connection string (Vercel Postgres / Neon / Supabase …)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------- Admin ----------
# Control-room password. Default development value: cu
ADMIN_PASSWORD=cu

# ---------- Object storage (production uploads) ----------
# Vercel Blob token — durable image storage. Without it, Vercel falls back
# to ephemeral /tmp storage (development only).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ---------- AI graduation-cap provider (optional) ----------
# If set, uses Google's image-editing model. Without it the app uses its
# built-in offline procedural cap compositor (works with no keys at all).
# GEMINI_API_KEY=AIza...
