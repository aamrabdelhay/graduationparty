# ------------------------------------------------------------------
# Graduation Party — environment variables
# Copy to `.env.local` (development) or configure in your host (Vercel).
# NEVER commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL. On Vercel use a pooled URL from Neon/Supabase/RDS.
# DIRECT_URL is used by migrations/scripts when DATABASE_URL is a pooled URL.
DATABASE_URL="postgres://postgres:postgres@localhost:55432/graduation_party"
DIRECT_URL=""

# Admin login password (server-side only). Development default: cu
ADMIN_PASSWORD="cu"

# ------------------------------------------------------------------
# Object storage
# STORAGE_PROVIDER=blob  -> Vercel Blob (BLOB_READ_WRITE_TOKEN required)
# STORAGE_PROVIDER=disk  -> local filesystem fallback (dev/test only, never in production)
STORAGE_PROVIDER="disk"
BLOB_READ_WRITE_TOKEN=""
# Optional custom blob host (bypasses the store.vercel-blob.com allowlist)
# BLOB_URL=""

# ------------------------------------------------------------------
# AI graduation-cap generation
# AI_PROVIDER=openai  -> real generation via OpenAI Images API (recommended)
# AI_PROVIDER=offline -> deterministic local placeholder generator (development/tests only)
# If AI_PROVIDER=openai and AI_API_KEY is missing, the app refuses AI calls with a clear error.
AI_PROVIDER="offline"
AI_API_KEY=""
AI_MODEL="gpt-image-1"
AI_IMAGE_SIZE="1024x1024"

# ------------------------------------------------------------------
# Optional hardening (defaults shown)
# SESSION_COOKIE_SECURE=true            # set true on https deployments
# APP_BASE_URL=""                       # e.g. https://your-app.vercel.app
